! ==============================================================================
! EnergyPlus Input Data File (IDF) - Eco-Loop Autonomous AI-Controlled Building
! Enables EMS Actuators, Python API Runtime Hooks, & Dynamic MCP Setpoint Overrides
! Project: Eco-Loop Building Agents (PES2UG23CS187 - Eshwar B N)
! ==============================================================================

Version, 24.1;

Building,
  Commercial_Office_EcoLoop_AI, ! Name
  0.0,                          ! North Axis {deg}
  Suburbs,                      ! Terrain
  0.04,                         ! Loads Convergence Tolerance Value {W}
  0.4,                          ! Temperature Convergence Tolerance Value {deltaC}
  FullExterior,                 ! Solar Distribution
  25,                           ! Maximum Number of Warmup Days
  6;                            ! Minimum Number of Warmup Days

Timestep, 4; ! 15-minute timesteps

GlobalGeometryRules, UpperLeftCorner, Counterclockwise, World;

! ------------------------------------------------------------------------------
! ZONES DEFINITION
! ------------------------------------------------------------------------------
Zone, Zone_North, 0, 0, 0, 0, 1, 150.0, 450.0;
Zone, Zone_South, 0, 0, 0, 0, 1, 180.0, 540.0;
Zone, Zone_East,  0, 0, 0, 0, 1, 120.0, 360.0;
Zone, Zone_West,  0, 0, 0, 0, 1, 120.0, 360.0;
Zone, Zone_Core,  0, 0, 0, 0, 1, 300.0, 900.0;

! ------------------------------------------------------------------------------
! DYNAMIC EMS ACTUATORS & PYTHON API OVERRIDES
! ------------------------------------------------------------------------------
EnergyManagementSystem:Actuator,
  EcoLoop_Cooling_Setpoint_North, Zone_North_Thermostat, Zone Control, Cooling Setpoint;

EnergyManagementSystem:Actuator,
  EcoLoop_Cooling_Setpoint_South, Zone_South_Thermostat, Zone Control, Cooling Setpoint;

EnergyManagementSystem:Actuator,
  EcoLoop_Cooling_Setpoint_Core, Zone_Core_Thermostat, Zone Control, Cooling Setpoint;

EnergyManagementSystem:ProgramCallingManager,
  EcoLoop_RealTime_Control_Loop,
  InsideHVACSystemIterationLoop,
  EcoLoop_Dynamic_Setpoint_Inject_Program;

EnergyManagementSystem:Program,
  EcoLoop_Dynamic_Setpoint_Inject_Program,
  ! Forward-injected values computed live by OSS LLM Cognitive Engine via MCP Server
  Set EcoLoop_Cooling_Setpoint_North = 24.5,
  Set EcoLoop_Cooling_Setpoint_South = 24.5,
  Set EcoLoop_Cooling_Setpoint_Core = 24.0;
